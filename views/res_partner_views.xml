<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_partner_form_payment_txt_generator" model="ir.ui.view">
            <field name="name">res.partner.form.payment.generator</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//group[field[@name='property_account_payable_id']]" position="after">
                    <group string="Generación de Archivos de Pago Bancario" name="payment_txt_generator_group" colspan="2">
                        <field name="x_confirming_key"/>
                        <field name="x_spei_reference"/>
                        <field name="x_confirming_sequence" invisible="1"/>
                    </group>
                </xpath>

            </field>
        </record>

    </data>
</odoo>