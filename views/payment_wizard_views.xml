<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_account_payment_register_form_inherit_payment_generator" model="ir.ui.view">
            <field name="name">account.payment.register.form.inherit.payment.generator</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_create_payments']" position="before">
                    <button name="action_create_payments_and_generate_file"
                            string="Crear Pago y Generar Archivo"
                            type="object"
                            class="btn-primary"
                            data-hotkey="g"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>